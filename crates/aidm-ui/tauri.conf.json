{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDM",
  "version": "1.0.0",
  "identifier": "app.aidm.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AIDM 下载管理器",
        "width": 1024,
        "height": 680,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "小熊宋",
    "copyright": "Copyright © 2026 小熊宋",
    "category": "Utility",
    "shortDescription": "Windows 下载管理器",
    "longDescription": "AIDM 是 Windows 下载管理器：引擎进程独占网络 IO，UI 进程零网络 IO，支持 HTTP/HTTPS、FTP/FTPS、BitTorrent、eD2k/Kad 等多协议下载。",
    "homepage": "https://github.com/fusongjie/AIDM",
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../extension/": "extension/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
